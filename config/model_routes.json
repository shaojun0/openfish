      "model": "deepseek-v4",
      "aliases": [
        "pro"
      ],
      "path": "/v1/chat/completions",
      "enabled": true,
      "description": "长上下文主力模型"
    },
    {
      "name": "bge-m3-embedding",
      "provider": "openai",
      "base_url": "http://10.0.0.11:8002",
      "api_key": "",
