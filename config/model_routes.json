{
  "version": 1,
  "_comment": "内网模型路由表（只发布，不代理推理）。openfish 负责登记、展示与连通性检测；持有 model:write 的管理员可在 /models 页面在线维护本文件。下游 DSH 读取本文件后自行决定 upstream 与鉴权方式。base_url 请替换成实际内网地址。provider 可选 openai / mineru / anthropic。",
  "routes": [
    {
      "name": "deepseek-v4-flash",
      "provider": "openai",
      "base_url": "http://10.0.0.10:8000",
      "api_key": "",
      "model": "deepseek-v4-flash",
      "aliases": [
        "flash",
        "default"
      ],
      "path": "/v1/chat/completions",
      "enabled": true,
      "description": "默认对话模型，走内网 vLLM 推理服务"
    },
    {
      "name": "deepseek-v4",
      "provider": "openai",
      "base_url": "http://10.0.0.10:8001",
