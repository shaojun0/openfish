# 内网 DSH / openfish 常用环境变量示例。
# 按需复制到 ~/.bashrc 或部署脚本里，把 BASE 换成实际地址。

BASE=http://127.0.0.1:9090

# Python 包索引（pip / uv）
PIP_INDEX_URL=$BASE/simple/
PIP_TRUSTED_HOST=127.0.0.1

# uv 的 CPython 解释器镜像
UV_PYTHON_INSTALL_MIRROR=$BASE/python-builds/

# npm registry（openfish 已实现 registry 协议）
NPM_CONFIG_REGISTRY=$BASE/npm/

# Docker Registry v2 拉取代理（需服务端配置 DOCKER_UPSTREAM）
# 注意：http 明文 registry 需要在客户端 daemon 的 insecure-registries 里登记，
# 正式环境请让 openfish 走 TLS。
# DOCKER_REGISTRY_MIRROR=$BASE/docker

# apt 镜像（需服务端配置 DEBIAN_UPSTREAM）
# deb [trusted=yes] $BASE/debian bookworm main

# 模型路由（供 DSH 读取；见 /models 页面）
OPENFISH_MODELS_URL=$BASE/api/v1/models
