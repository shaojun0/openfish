# ── openfish Forgejo 容器环境变量模板 ────────────────────────────────
#
# 用法:  cp docker/forgejo/forgejo.env.example docker/forgejo/forgejo.env
#        然后填写 SECRET_KEY / INTERNAL_TOKEN / JWT_SECRET 与 FORGEJO_ADMIN_TOKEN。
#
# docker/forgejo/forgejo.env 会被 docker-compose.yml 的 forgejo 服务用
# env_file 读取，必须 **chmod 600**，且绝不能提交到仓库（docker/.gitignore
# 已忽略 docker/forgejo/*.env）。
#
# 本文件只放 *非机密* 的默认值；真正的密钥由 `docker compose` 变量插值或
# 运维在 .env 里填写。backEnd 侧读的是同一份值：
#   FORGEJO_ADMIN_TOKEN     →  backend 服务的 FORGEJO_ADMIN_TOKEN
#   FORGEJO_WEBHOOK_SECRET  →  backend 服务的 FORGEJO_WEBHOOK_SECRET
# 两处必须一致，否则导入能跑但 webhook 会 401。
#
# 版本锚定: 见 docker/forgejo/README.md（v15 LTS / v16 的取舍）。
#   FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:15

# ── 镜像 ────────────────────────────────────────────────────────────
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:15

# ── 实例标识 ────────────────────────────────────────────────────────
# 公开基址。走本 compose 的 nginx 时是 https://<host>:20416/git/，
# 前面还有一层 TLS 网关时就写那个对外地址。末尾斜杠**必须保留**，
# Forgejo 用它生成 clone URL 与 webhook 回调地址。
FORGEJO__server__ROOT_URL=https://registry.example.invalid:20416/git/
FORGEJO__server__DOMAIN=registry.example.invalid
FORGEJO__server__HTTP_PORT=3000
# SSH 本轮不启用（§0.2）；只走 HTTP smart protocol，由 nginx 的 /git/ 暴露。
FORGEJO__server__DISABLE_SSH=true
FORGEJO__server__START_SSH_SERVER=false
FORGEJO__server__OFFLINE_MODE=true

# ── 必填：三个应用级密钥（生成方式见 README.md）────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FORGEJO__security__SECRET_KEY=
FORGEJO__security__INTERNAL_TOKEN=
FORGEJO__oauth2__JWT_SECRET=

# ── 安装引导：跳过网页安装向导，直接用环境变量建库 ────────────────
FORGEJO__database__DB_TYPE=sqlite3
FORGEJO__database__PATH=/data/forgejo/forgejo.db
FORGEJO__database__LOG_SQL=false
# 关掉自助注册：内网仓库由管理员建，账号不等于 openfish 账号。
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=true
FORGEJO__service__DEFAULT_KEEP_EMAIL_PRIVATE=true
FORGEJO__service__ENABLE_NOTIFY_MAIL=false

# ── LFS / Actions 本轮都不需要 ──────────────────────────────────────
FORGEJO__lfs__START_SERVER=false
FORGEJO__repository__DISABLE_HTTP_GIT=false
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__actions__ENABLED=false

# ── 反代（nginx 终止连接，容器只在内网）────────────────────────────
FORGEJO__server__PROTOCOL=http
FORGEJO__server__ENABLE_PROXY_PROTOCOL=false
# 信任 compose 网络里的 nginx；不要填 *。
# 注意: FORGEJO__xxx__yyy 形式的 host 名无法在 env_file 里做变量插值，
# 这里用容器名，与本 compose 的 forgejo 服务名一致。
FORGEJO__security__REVERSE_PROXY_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# ── 迁移/镜像 ───────────────────────────────────────────────────────
# 大仓（vllm 量级）迁移需要比默认更长的超时与更大的缓冲。
FORGEJO__migrations__MAX_ATTEMPTS=3
FORGEJO__migrations__RETRY_BACKOFF=10
FORGEJO__cron__ENABLED=true

# ── 日志 ────────────────────────────────────────────────────────────
FORGEJO__log__LEVEL=Info
FORGEJO__log__ROOT_PATH=/data/forgejo/log

# ── 下面两个由运维生成，backend 侧读同名变量（见上方说明）──────────
# 生成（容器起来、管理员账号建好之后，见 README.md「生成 admin token」）：
#   docker exec -u git openfish-forgejo \
#     forgejo admin user generate-access-token \
#     --username openfish-admin --token-name openfish-platform --scopes all --raw
FORGEJO_ADMIN_TOKEN=
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
FORGEJO_WEBHOOK_SECRET=
