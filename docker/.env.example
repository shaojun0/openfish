# ── docker compose 环境变量模板 ─────────────────────────────────────
# 用法:  cp docker/.env.example docker/.env  然后填写真实值。
# docker/.env 已被 .gitignore 忽略，绝不会进入仓库。
#
# docker compose 会自动读取与本文件同目录（docker/）下的 .env。
# 本文件是 compose 的变量插值来源，同时其中的值会被注入 backend 容器。
# 只跑后端本地开发时用的是 backend/.env.example，不是这一份。

# ── 必填：会话签名密钥 ──────────────────────────────────────────────
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Basic Auth ──────────────────────────────────────────────────────
AUTH_USERNAME=admin
# 留空表示不启用 Basic Auth 口令校验
AUTH_ASSERT=

# ── OAuth2（全部留空则自动禁用 OAuth2 相关代码路径）───────────────
OAUTH2_PRODUCT_ID=0
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=
OAUTH2_AUTHORIZE_URL=
OAUTH2_INTROSPECT_URL=
# 私有 CA 证书路径（PEM）。留空 = 用系统信任库。
# 没有"关闭校验"的开关：introspection 一旦不校验证书，中间人就能伪造任意身份登录。
OAUTH2_CA_BUNDLE=
IS_4A=false

# ── 对外基址（设备授权流程用）───────────────────────────────────────
# DSH 企业内网插件会把这个地址展示给用户点击。走本 compose 的 nginx 反代时
# 留空即可（服务端从 Host / X-Forwarded-* 推导）；只有 nginx 之前还有一层
# 负载均衡/端口映射时才需要显式设置，例如 https://mirror.intra:9443
PUBLIC_BASE_URL=

# ── 端口映射与运行态 ────────────────────────────────────────────────
# nginx 边缘网关对外的 HTTP 端口（唯一对外端口）
PYPISERVER_PORT=20416
# backend-debug 容器（profile: debug）的端口
PYPISERVER_DEBUG_PORT=20417
# 下面两个都是**容器内**路径，不是宿主机路径。
# /app/share 对应宿主机 docker/share；packages / cpython 是其下的两个子目录。
PACKAGES_DIR=/app/share/python
PYTHON_BUILDS_DIR=/app/share/python-build-standalone

# ── 制品库 / 运行态的宿主机来源（符号链接，不在这里配置）────────────
# compose 的每一个 bind-mount 源都写成 docker/ 下的相对路径（./share ./npm
# ./node-builds ./docker-images ./debian ./data ./config/model_routes.json
# ./tools ./docs），因此本文件里**没有任何宿主机绝对路径**。
# 需要把某类数据放到另一块盘时，只需重指 docker/ 下的同名符号链接：
#
#   ln -sfn /srv/openfish-mirror/npm  docker/npm
#
# 全新克隆后先跑一次 docker/prepare-mounts.sh：不带参数就把这些源建成真实目录
# （并用 docker/examples/ 里的样例目录播种），带一个数据盘路径就把它们指过去：
#
#   ./prepare-mounts.sh                                   # 本地/样例
#   ./prepare-mounts.sh /media/disk/openfish-mirror       # 数据盘布局
#
# 细节见 docker/README.md。无论哪种方式，都不需要改 compose，也不需要改本文件。

# ── 前端镜像构建（frontend/Dockerfile）──────────────────────────────
# npm 源；留空用 npm 默认源。内网建议 https://registry.npmmirror.com
NPM_REGISTRY=

# ── 内网制品中心：只读穿透代理 ──────────────────────────────────────
# 三者都是"本地优先、未命中才回源"的只读代理；把回源地址留空即退化为
# 纯本地模式（只服务已经放进目录或缓存里的制品）。
#
# npm registry：packument / tarball / /-/v1/search
NPM_UPSTREAM=https://registry.npmmirror.com
NPM_PROXY_ENABLED=true
# 上游 registry 需要鉴权时填写 Bearer token
NPM_UPSTREAM_TOKEN=
NPM_TIMEOUT=30
# 缓存落在 API_KEYS_FILE 所在的 /app/data 卷里，随容器持久化
NPM_CACHE_MAX_MB=512
#
# Docker Registry v2：Docker Hub 用 https://registry-1.docker.io，
# 内网 registry 用 http://registry.intra:5000
DOCKER_UPSTREAM=
DOCKER_UPSTREAM_USERNAME=
DOCKER_UPSTREAM_PASSWORD=
# 单段镜像名补的命名空间（Docker Hub 官方镜像为 library；内网 registry 置空）
DOCKER_DEFAULT_NAMESPACE=library
DOCKER_TIMEOUT=60
DOCKER_CACHE_MAX_MB=1024
#
# apt 镜像：例如 http://deb.debian.org/debian
DEBIAN_UPSTREAM=
DEBIAN_TIMEOUT=60
DEBIAN_CACHE_MAX_MB=256
# 代理的 Release / Packages 缓存有效期（秒）
DEBIAN_METADATA_TTL=300

# ── 可选数据库（profile: db）────────────────────────────────────────
# 应用目前**并未接入** PostgreSQL：授权、API key 与统计仍存在
# backend/data/cpypiserver.db。这组变量只有在你显式启用 db profile
# （docker compose --profile db up -d）时才会用到，且暂时不影响应用行为。
POSTGRES_DB=openfish
POSTGRES_USER=openfish
POSTGRES_PASSWORD=
