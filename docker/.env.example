# ── docker compose 环境变量模板 ─────────────────────────────────────
# 用法:  cp docker/.env.example docker/.env  然后填写真实值。
# docker/.env 已被 .gitignore 忽略，绝不会进入仓库。
#
# docker compose 会自动读取与本文件同目录（docker/）下的 .env。
# 本文件是 compose 的变量插值来源，同时其中的值会被注入 backend 容器。
# 只跑后端本地开发时用的是 backend/.env.example，不是这一份。

# ── 必填：会话签名密钥 ──────────────────────────────────────────────
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Basic Auth ──────────────────────────────────────────────────────
AUTH_USERNAME=admin
# 留空表示不启用 Basic Auth 口令校验
AUTH_ASSERT=

# ── OAuth2（全部留空则自动禁用 OAuth2 相关代码路径）───────────────
OAUTH2_PRODUCT_ID=0
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=
OAUTH2_AUTHORIZE_URL=
OAUTH2_INTROSPECT_URL=
# 私有 CA 证书路径（PEM）。留空 = 用系统信任库。
# 没有"关闭校验"的开关：introspection 一旦不校验证书，中间人就能伪造任意身份登录。
OAUTH2_CA_BUNDLE=
IS_4A=false

# ── 对外基址（设备授权流程用）───────────────────────────────────────
# DSH 企业内网插件会把这个地址展示给用户点击。走本 compose 的 nginx 反代时
# 留空即可（服务端从 Host / X-Forwarded-* 推导）；只有 nginx 之前还有一层
# 负载均衡/端口映射时才需要显式设置，例如 https://mirror.intra:9443
PUBLIC_BASE_URL=

# ── 端口映射与运行态 ────────────────────────────────────────────────
# nginx 边缘网关对外的 HTTP 端口（唯一对外端口）
PYPISERVER_PORT=20416
# backend-debug 容器（profile: debug）的端口
PYPISERVER_DEBUG_PORT=20417
# 下面两个都是**容器内**路径，不是宿主机路径。
# /app/share 对应宿主机 docker/share；packages / cpython 是其下的两个子目录。
PACKAGES_DIR=/app/share/python
PYTHON_BUILDS_DIR=/app/share/python-build-standalone

# ── 制品库 / 运行态的宿主机来源（符号链接，不在这里配置）────────────
# compose 的每一个 bind-mount 源都写成 docker/ 下的相对路径（./share ./npm
# ./node-builds ./docker-images ./debian ./data ./config/model_routes.json
# ./tools ./docs），因此本文件里**没有任何宿主机绝对路径**。
# 需要把某类数据放到另一块盘时，只需重指 docker/ 下的同名符号链接：
#
#   ln -sfn /srv/openfish-mirror/npm  docker/npm
#
# 全新克隆后先跑一次 docker/prepare-mounts.sh：不带参数就把这些源建成真实目录
# （并用 docker/examples/ 里的样例目录播种），带一个数据盘路径就把它们指过去：
#
#   ./prepare-mounts.sh                                   # 本地/样例
#   ./prepare-mounts.sh /media/disk/openfish-mirror       # 数据盘布局
#
# 细节见 docker/README.md。无论哪种方式，都不需要改 compose，也不需要改本文件。

# ── 前端镜像构建（frontend/Dockerfile）──────────────────────────────
# npm 源；留空用 npm 默认源。内网建议 https://registry.npmmirror.com
NPM_REGISTRY=

# ── 内网制品中心：只读穿透代理 ──────────────────────────────────────
# 三者都是"本地优先、未命中才回源"的只读代理；把回源地址留空即退化为
# 纯本地模式（只服务已经放进目录或缓存里的制品）。
#
# npm registry：packument / tarball / /-/v1/search
NPM_UPSTREAM=https://registry.npmmirror.com
NPM_PROXY_ENABLED=true
# 上游 registry 需要鉴权时填写 Bearer token
NPM_UPSTREAM_TOKEN=
NPM_TIMEOUT=30
# 缓存落在 API_KEYS_FILE 所在的 /app/data 卷里，随容器持久化
NPM_CACHE_MAX_MB=512
#
# Docker Registry v2：Docker Hub 用 https://registry-1.docker.io，
# 内网 registry 用 http://registry.intra:5000
DOCKER_UPSTREAM=
DOCKER_UPSTREAM_USERNAME=
DOCKER_UPSTREAM_PASSWORD=
# 单段镜像名补的命名空间（Docker Hub 官方镜像为 library；内网 registry 置空）
DOCKER_DEFAULT_NAMESPACE=library
DOCKER_TIMEOUT=60
DOCKER_CACHE_MAX_MB=1024
#
# apt 镜像：例如 http://deb.debian.org/debian
DEBIAN_UPSTREAM=
DEBIAN_TIMEOUT=60
DEBIAN_CACHE_MAX_MB=256
# 代理的 Release / Packages 缓存有效期（秒）
DEBIAN_METADATA_TTL=300
#
# 离线更新中继：互联网侧导出快照，内网侧对比生成待更新清单，
# 互联网侧按清单打包，内网侧导入。快照枚举下面这套 suite/组件/架构。
DEBIAN_SUITES=bookworm bookworm-updates bookworm-security
DEBIAN_COMPONENTS=main
DEBIAN_ARCHES=amd64
# 单个离线包（及一次构建将下载的总大小）上限，MiB；0 表示不限制
DEBIAN_OFFLINE_MAX_MB=4096
# 是否把 Recommends 纳入依赖闭包（默认否，只跟随 Depends/Pre-Depends）
DEBIAN_OFFLINE_RECOMMENDS=false

# ── 数据库后端（默认 SQLite，可选 PostgreSQL）───────────────────────
# 留空 DATABASE_URL = 使用 API_KEYS_FILE 指向的 SQLite 文件（/app/data 卷），
# 这是默认行为，也是从旧部署升级过来时数据所在的地方。
#
# 想切到 PostgreSQL：
#   1) 填好下面的 POSTGRES_* 口令；
#   2) 把 DATABASE_URL 指向 db 服务（用户名/口令/库名要和 POSTGRES_* 一致，
#      口令里含 @ : / 等字符时做 URL 编码）；
#   3) 用 `docker compose --profile db up -d` 启动（db 服务在 db profile 下）。
# 想同时获得健康检查级别的启动顺序，再加 -f docker-compose.postgres.yml。
#
# 切换是"换一个库"而不是"迁移数据"：现有 SQLite 里的账号/角色/API key 需要
# 用 cli.py 在新库上重建，见 docker/README.md 的 "PostgreSQL" 一节。
#
# DATABASE_URL=postgresql+psycopg://openfish:<口令>@db:5432/openfish

POSTGRES_DB=openfish
POSTGRES_USER=openfish
POSTGRES_PASSWORD=

# ── Agent 运行时（profile: runner）───────────────────────────────────
# headless review 命令。留空时 review 任务会**明确失败**（不会被静默当 done），
# 直到你配置一个能往 stdout 打印 findings JSON 数组的命令。
# AGENT_REVIEW_COMMAND=/app/tools/review --policy .agent/review-policy.yml
AGENT_REVIEW_TIMEOUT=900
# 结果门控的 PR：留空 = 由每个仓库的 .agent/review-policy.yml 决定；没有 policy
# 的仓库用内建默认 on_green。只有运维要**覆盖所有仓库**时才在这里填
# on_green / always / never。
AGENT_PR_POLICY=
# 是否允许 push 触发的 review 在有失败 gate 时升级为 fix+PR；留空 = 由仓库
# policy 决定（内建默认 false，见 AGENTS §6.4）。
AGENT_AUTO_FIX=
# 每个副本的 worker 参数（§9.1）
AGENT_WORK_RETENTION_SECONDS=86400
AGENT_GATE_TIMEOUT=120
AGENT_MAX_FINDINGS=50
# 生产侧准入控制：同一仓库的在途（queued/leased/running）任务上限，0 表示不限。
# 默认 2，webhook 风暴不会再把单一仓库灌满全局队列；被抑制的投递会以
# delivered=false 回给 webhook（而不是假装已入队）。
AGENT_MAX_IN_FLIGHT_PER_REPO=2

# ── Forgejo 凭据（runner 沙箱专用）───────────────────────────────────
# runner 容器会执行被审仓库自带的 check_*.py 与 headless review 命令，因此它
# **不**继承 backend 的 FORGEJO_ADMIN_TOKEN / SECRET_KEY / GIT_IDENTITY_KEY
# （见 compose 的 x-runner-env 与 services/sandbox_env.py）。
#
# 它需要一枚**独立、可单独吊销、非 admin** 的 Forgejo 访问令牌，同时用于：
#   * git clone/push（credential.helper + OPENFISH_GIT_TOKEN，不进 argv/URL）；
#   * 用 Forgejo REST 开 PR。
# 建议在 Forgejo 里建一个只对目标仓库有写权限的 bot 账号并签发 token：
#   docker exec -u git openfish-forgejo forgejo admin user generate-access-token \
#     --username openfish-agent --token-name openfish-runner --scopes write:repository --raw
# 留空时 review 仍可运行，但 fix 任务会在 push/PR 处**明确失败**，不会回落去用
# admin 权限。
FORGEJO_RUNNER_TOKEN=
