# ── docker compose 环境变量模板 ─────────────────────────────────────
# 用法:  cp docker/.env.example docker/.env  然后填写真实值。
# docker/.env 已被 .gitignore 忽略，绝不会进入仓库。
#
# docker compose 会自动读取与本文件同目录（docker/）下的 .env。
# 本文件是 compose 的变量插值来源，同时其中的值会被注入 backend 容器。
# 只跑后端本地开发时用的是 backend/.env.example，不是这一份。
#
# 契约：**本文件里的每一个变量都会被 compose 转发进对应容器**（backend /
# frontend / runner），没有"写了也不生效"的旋钮，也没有只存在于别处的暗开关。
# compose 直接写死的容器内取值、以及刻意不暴露的三个变量，列在文件末尾。

# ── 必填：会话签名密钥 ──────────────────────────────────────────────
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── 服务器 ──────────────────────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR。留空 = INFO。
LOG_LEVEL=
# 私有 CA 链，匿名发布在 GET /certs/ca_chain.pem 供内网客户端安装。
# 留空 = /app/certs/ca_chain.pem（容器内路径）。把 CA 放进 docker/certs/ 后
# 取消 docker-compose.yml 里那个只读挂载即可；路径不存在只是 404，没有开关。
TLS_CA_FILE=
# 管理端统计的后台刷新间隔（秒）。留空 = 7200。
STATS_CACHE_SECONDS=

# ── Basic Auth ──────────────────────────────────────────────────────
AUTH_USERNAME=admin
# 留空表示不启用 Basic Auth 口令校验
AUTH_ASSERT=
# 注意：AUTH_ENABLED 刻意不在这里，也不由 compose 转发（拓扑永远开着认证）。
# 要关闭认证请改 docker-compose.yml，见文件末尾「不在 .env 里的旋钮」。

# ── OAuth2（全部留空则自动禁用 OAuth2 相关代码路径）───────────────
OAUTH2_PRODUCT_ID=0
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=
OAUTH2_AUTHORIZE_URL=
OAUTH2_INTROSPECT_URL=
# 私有 CA 证书路径（PEM）。留空 = 用系统信任库。
# 没有"关闭校验"的开关：introspection 一旦不校验证书，中间人就能伪造任意身份登录。
OAUTH2_CA_BUNDLE=
# 4A 风格流程附加的 auth-preference 查询参数。留空 = 不带。
OAUTH2_AUTH_PREFERENCE=
IS_4A=false

# ── 对外基址（设备授权流程用）───────────────────────────────────────
# DSH 企业内网插件会把这个地址展示给用户点击。走本 compose 的 nginx 反代时
# 留空即可（服务端从 Host / X-Forwarded-* 推导）；只有 nginx 之前还有一层
# 负载均衡/端口映射时才需要显式设置，例如 https://mirror.intra:9443
PUBLIC_BASE_URL=

# ── 设备授权流程（DSH 企业内网插件）─────────────────────────────────
# 待授权请求的落盘位置。留空 = /app/data/device_codes.json（随数据卷持久化）。
DEVICE_CODES_FILE=
# 待授权请求的有效期（秒）；超时后插件要从头再来。留空 = 900。
DEVICE_CODE_TTL=

# ── 模型路由连通性探测 ──────────────────────────────────────────────
# 一次探测的超时（秒）。留空 = 5。探测只验证 URL 能应答，不带任何凭据。
MODEL_PROBE_TIMEOUT=
# 允许探测的主机白名单，**JSON 数组**，例如 ["api.deepseek.com","llm.intra:8443"]。
# 留空 = 默认策略（不额外收紧）。
MODEL_PROBE_ALLOWED_HOSTS=

# ── 端口映射与运行态 ────────────────────────────────────────────────
# nginx 边缘网关对外的 HTTP 端口（唯一对外端口）
PYPISERVER_PORT=20416
# backend-debug 容器（profile: debug）的端口
PYPISERVER_DEBUG_PORT=20417
# 下面两个都是**容器内**路径，不是宿主机路径。
# /app/share 对应宿主机 docker/share；packages / cpython 是其下的两个子目录。
PACKAGES_DIR=/app/share/python
PYTHON_BUILDS_DIR=/app/share/python-build-standalone

# ── 制品库 / 运行态的宿主机来源（符号链接，不在这里配置）────────────
# compose 的每一个 bind-mount 源都写成 docker/ 下的相对路径（./share ./npm
# ./node-builds ./docker-images ./debian ./data ./tools ./docs），因此本文件里
# **没有任何宿主机绝对路径**。
# 需要把某类数据放到另一块盘时，只需重指 docker/ 下的同名符号链接：
#
#   ln -sfn /srv/openfish-mirror/npm  docker/npm
#
# 没有任何前置步骤：缺失的 bind 源由 Docker 在 `docker compose up` 时创建（空目录、
# root 属主）。要把某类数据放到另一块盘，重指 docker/ 下的同名符号链接即可：
#
#   ln -sfn /media/disk/openfish-mirror/npm docker/npm
#
# 细节见根 README.md。无论哪种方式，都不需要改 compose，也不需要改本文件。

# ── 目录介质：本地目录（默认）或 S3 兼容对象存储 ─────────────────────
# 工具与文档的条目在数据库里，字节走存储端口 services/objectstore.py；默认 local
# 即"对象放在 <目录>/objects/<uuid4>"（与历史行为一致，无需配置）。
# 空数据库首次启动时，后端会用 backend/config/seed/ 里的默认内容初始化这两个
# 目录，因此面板起来就有文档和工具；运维自己丢进去的文件仍要 `cli.py docs|tools
# import`。要拿回被删掉的默认内容：`python cli.py catalogs seed --force`。
# 切到 S3 兼容存储（MinIO / Ceph / 云 S3）时改这一组，并重建镜像带上可选依赖：
#   docker compose build --build-arg OPENFISH_EXTRAS=s3 backend
# 桶必须由运维预建（应用不会自动建桶）；MinIO/Ceph 用具名寻址 path。
# 这些变量会由 compose 显式转发进容器（见 docker-compose.yml 的 x-backend-env）。
# OBJECT_BACKEND=local
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET_NAME=openfish
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ADDRESS_STYLE=path
# S3_PREFIX=openfish

# ── 前端镜像构建（frontend/Dockerfile）──────────────────────────────
# npm 源；留空用 npm 默认源。内网建议 https://registry.npmmirror.com
NPM_REGISTRY=
# SPA 侧边栏显示的构建标识；留空 = 构建时刻（vite.config.ts 的默认）。
# CI 里建议填 git describe / 发布号，让线上页面能对上具体构建。
BUILD_ID=

# ── 内网制品中心：只读穿透代理 ──────────────────────────────────────
# 三者都是"本地优先、未命中才回源"的只读代理；把回源地址留空即退化为
# 纯本地模式（只服务已经放进目录或缓存里的制品）。
#
# npm registry：packument / tarball / /-/v1/search
NPM_UPSTREAM=https://registry.npmmirror.com
NPM_PROXY_ENABLED=true
# 上游 registry 需要鉴权时填写 Bearer token
NPM_UPSTREAM_TOKEN=
NPM_TIMEOUT=30
# 缓存落在 API_KEYS_FILE 所在的 /app/data 卷里，随容器持久化
NPM_CACHE_MAX_MB=512
#
# Docker Registry v2：Docker Hub 用 https://registry-1.docker.io，
# 内网 registry 用 http://registry.intra:5000
DOCKER_UPSTREAM=
# 给客户端展示的内网 registry 地址（UI 里的 docker login 目标），并在
# DOCKER_UPSTREAM 留空时作为它的默认值；留空 = 不展示/不复用。
DOCKER_REGISTRY=
DOCKER_UPSTREAM_USERNAME=
DOCKER_UPSTREAM_PASSWORD=
# 单段镜像名补的命名空间（Docker Hub 官方镜像为 library；内网 registry 置空）
DOCKER_DEFAULT_NAMESPACE=library
DOCKER_TIMEOUT=60
DOCKER_CACHE_MAX_MB=1024
#
# apt 镜像：例如 http://deb.debian.org/debian
DEBIAN_UPSTREAM=
# 给客户端展示的内网 apt 镜像地址（UI 里的 sources.list 目标），并在
# DEBIAN_UPSTREAM 留空时作为它的默认值；留空 = 不展示/不复用。
DEBIAN_MIRROR=
DEBIAN_TIMEOUT=60
DEBIAN_CACHE_MAX_MB=256
# 代理的 Release / Packages 缓存有效期（秒）
DEBIAN_METADATA_TTL=300

# ── 上传校验与首启种子 ──────────────────────────────────────────────
# 空库首启是否写入 backend/config/seed/ 的默认内容（文档/工具条目）。
# 留空 = true。关掉就得到完全空的面板，之后只能靠 cli.py 导入。
SEED_CATALOGS=
# 用 watchdog 监听各目录，维持 in-memory 索引（容器里 bind-mount 同样有效）。
# 留空 = true。
WATCH_PACKAGES=
# 允许的上传扩展名，**JSON 数组**，例如 ["whl","zip","tar.gz","tar"]。
# 留空 = whl / zip / tar.gz / tar。
ALLOW_EXTENSIONS=
# 是否允许覆盖已存在的同名包。留空 = false（第二次上传报冲突）。
OVERWRITE=

# ── ClamAV / GuardDog 上传扫描 ──────────────────────────────────────
# clamd 不在本 compose 里：CLAMAV_HOST 留空即禁用病毒扫描；填了才连过去扫。
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT=
# true = ClamAV 不可用时拒绝上传；留空/false = 只告警不阻断。
CLAMAV_REQUIRED=
# GuardDog（YARA + 风险引擎）随镜像安装在非 Windows 平台，默认 enabled。
GUARDDOG_ENABLED=
# true = GuardDog 不可用时拒绝上传；留空 = false。
GUARDDOG_REQUIRED=
# 风险分达到此值即拒绝上传；留空 = 5.0（GuardDog 自己的 suspicious 档）。
GUARDDOG_MIN_RISK_SCORE=
# top-packages 列表缓存目录；留空 = /app/data/guarddog（随数据卷持久化）。
GUARDDOG_CACHE_DIR=

# ── 数据库后端（默认 SQLite，可选 PostgreSQL）───────────────────────
# 留空 DATABASE_URL = 使用 API_KEYS_FILE 指向的 SQLite 文件（/app/data 卷），
# 这是默认行为，也是从旧部署升级过来时数据所在的地方。
#
# 想切到 PostgreSQL：
#   1) 填好下面的 POSTGRES_* 口令；
#   2) 把 DATABASE_URL 指向 db 服务（用户名/口令/库名要和 POSTGRES_* 一致，
#      口令里含 @ : / 等字符时做 URL 编码）；
#   3) 用 `docker compose --profile db up -d` 启动（db 服务在 db profile 下）。
# 想同时获得健康检查级别的启动顺序，再加 -f docker-compose.postgres.yml。
#
# 切换是"换一个库"而不是"迁移数据"：现有 SQLite 里的账号/角色/API key 需要
# 用 cli.py 在新库上重建，见 docker/README.md 的 "PostgreSQL" 一节。
#
# DATABASE_URL=postgresql+psycopg://openfish:<口令>@db:5432/openfish

POSTGRES_DB=openfish
POSTGRES_USER=openfish
POSTGRES_PASSWORD=

# ── Agent 运行时（profile: runner）───────────────────────────────────
# headless review 命令。留空时 review 任务会**明确失败**（不会被静默当 done），
# 直到你配置一个能往 stdout 打印 findings JSON 数组的命令。
# AGENT_REVIEW_COMMAND=/app/tools/review --policy .agent/review-policy.yml
AGENT_REVIEW_TIMEOUT=900
# 结果门控的 PR：留空 = 由每个仓库的 .agent/review-policy.yml 决定；没有 policy
# 的仓库用内建默认 on_green。只有运维要**覆盖所有仓库**时才在这里填
# on_green / always / never。
AGENT_PR_POLICY=
# 是否允许 push 触发的 review 在有失败 gate 时升级为 fix+PR；留空 = 由仓库
# policy 决定（内建默认 false，见 AGENTS §6.4）。
AGENT_AUTO_FIX=
# 每个副本的 worker 参数（§9.1）
# backend 侧登记任务用的工作根目录（runner 容器里固定挂到 /work）。
# 留空 = /work。
AGENT_WORK_ROOT=
AGENT_WORK_RETENTION_SECONDS=86400
AGENT_GATE_TIMEOUT=120
AGENT_MAX_FINDINGS=50
# 生产侧准入控制：同一仓库的在途（queued/leased/running）任务上限，0 表示不限。
# 默认 2，webhook 风暴不会再把单一仓库灌满全局队列；被抑制的投递会以
# delivered=false 回给 webhook（而不是假装已入队）。
AGENT_MAX_IN_FLIGHT_PER_REPO=2

# ── Agent Hub 落库密钥（Fernet）──────────────────────────────────────
# 两枚密钥刻意分离，**不互相回退**；都缺省生成方法：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 用户身份主密钥：只给 backend，加密 git_identities 表里的 Forgejo token。
# 留空时 /api/v1/repos/<slug>/git-credential 返回 503（不回退明文）。
GIT_IDENTITY_KEY=
# 仓库凭据专用密钥：backend 用它密封 repo_runners.credential_ciphertext，
# runner 容器用**同一个值**解开。只给 runner 这枚，不给 GIT_IDENTITY_KEY。
# 两侧都留空时 per-repo runner 凭据写入直接拒绝（fail-closed）。
RUNNER_CREDENTIAL_KEY=
# 模型路由专用密钥：backend 用它密封 model_routes 表里每条路由的上游 api_key，
# 数据库/备份/副本因此都不含可直接使用的上游凭证。**只给 backend**：下游 DSH 从
# /api/v1/models/resolved 拿到的已经是解密后的明文，没有理由再持有主密钥。
# 留空时保存路由密钥直接拒绝（fail-closed，不回退明文）；已密封的行报
# api_key_source=unreadable。密钥本身用 CLI 写入，不进 .env：
#   docker compose exec backend python cli.py model-route list
#   docker compose exec backend python cli.py model-route set-key deepseek-flash \
#     --key-env ENTERPRISE_DEEPSEEK_API_KEY     # 该变量需先注入 backend 容器
MODEL_ROUTE_KEY=

# ── Forgejo 面与仓库导入 ─────────────────────────────────────────────
# backend 在 compose 内网里访问 Forgejo；正常情况下保持默认即可。
# 承载 Forgejo 的镜像与 tag。留空 = codeberg.org/forgejo/forgejo:15。
FORGEJO_IMAGE=
# Forgejo 的内网基址。留空 = http://forgejo:3000（compose 服务名）。
FORGEJO_BASE_URL=
# git-over-HTTP 与 REST 分处不同主机名/端口时才填；留空 = 与 FORGEJO_BASE_URL 相同。
FORGEJO_GIT_BASE_URL=
# 承载镜像仓库的组织名（repos.forgejo_repo = "<owner>/<owner>__<name>"）。
# 留空 = openfish。
FORGEJO_OWNER=
# 展示给客户端的公开 git 前缀（只用于生成 URL，不参与认证）。留空 = /git。
FORGEJO_PUBLIC_BASE_URL=
# 导入仓库的 bare mirror 落盘目录。留空 = /app/data/forgejo-mirror（随数据卷持久化）。
GIT_MIRROR_DIR=
# 从外部 GitHub / Gitee / GitLab 导入时用于 clone 的凭据（token，或 user:pass）。
# 留空 = 只能导入匿名可达的仓库。**密钥**：只走环境变量，不进仓库、不进日志。
IMPORT_SOURCE_TOKEN=
# 大仓保护（§8.2）：到上限标 partial=true 并由 API 显式暴露，绝不静默截断。
# 单个导入任务的 issue / commit 上限。留空 = 20000 / 5000。
IMPORT_MAX_ISSUES=
IMPORT_MAX_COMMITS=
# 对 Forgejo 的请求速率（次/秒，进程内共享）。留空 = 2。
IMPORT_MAX_RATE=
# Forgejo 列表分页大小 / 轮询间隔（秒）/ 轮询次数上限。
# 留空 = 50 / 2 / 150（默认约 5 分钟）。
IMPORT_PAGE_SIZE=
IMPORT_POLL_INTERVAL=
IMPORT_POLL_ATTEMPTS=
# 单次 Forgejo REST 调用的读超时（秒）。留空 = 30。
IMPORT_HTTP_TIMEOUT=

# ── Forgejo 平台凭据（backend 专用）──────────────────────────────────
# backend 用它们对 Forgejo 发 REST 调用、校验 webhook 签名；compose 从**本文件**插值
# 传给 backend。**不要**写进 docker/forgejo/forgejo.env：那个文件只进 forgejo 容器，
# compose 不从它插值，填在那里 backend 会拿到空值（git-credential 端点 503）。
#
# 生成 admin token（容器起来、管理员账号建好之后；见 README「生成 admin token」）：
#   docker exec -u git openfish-forgejo \
#     forgejo admin user generate-access-token \
#     --username openfish-admin --token-name openfish-platform --scopes all --raw
FORGEJO_ADMIN_TOKEN=
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
FORGEJO_WEBHOOK_SECRET=

# ── Forgejo 凭据（runner 沙箱专用）───────────────────────────────────
# runner 容器会执行被审仓库自带的 check_*.py 与 headless review 命令，因此它
# **不**继承 backend 的 FORGEJO_ADMIN_TOKEN / SECRET_KEY / GIT_IDENTITY_KEY
# （见 compose 的 x-runner-env 与 services/sandbox_env.py）。
#
# 它需要一枚**独立、可单独吊销、非 admin** 的 Forgejo 访问令牌，同时用于：
#   * git clone/push（credential.helper + OPENFISH_GIT_TOKEN，不进 argv/URL）；
#   * 用 Forgejo REST 开 PR。
# 建议在 Forgejo 里建一个只对目标仓库有写权限的 bot 账号并签发 token：
#   docker exec -u git openfish-forgejo forgejo admin user generate-access-token \
#     --username openfish-agent --token-name openfish-runner --scopes write:repository --raw
# 留空时 review 仍可运行，但 fix 任务会在 push/PR 处**明确失败**，不会回落去用
# admin 权限。
FORGEJO_RUNNER_TOKEN=

# ── 不在 .env 里的旋钮（compose 直接写死 / 刻意不暴露）───────────────
# 下面这些**不要**往 docker/.env 里写：compose 不从这里插值，写了也不生效。
#
# compose 写死的容器内取值（要改请改 docker-compose.yml）：
#   - HOST → 0.0.0.0，PORT → 8080，DEBUG → false（debug profile 里是 true）
#   - SERVER_NAME → cpypiserver
#   - API_KEYS_FILE → /app/data/cpypiserver.db
#   - TOOLS_DIR → /app/tools，NPM_DIR → /app/npm，NODE_BUILDS_DIR → /app/node-builds，
#     DOCKER_DIR → /app/docker-images，DEBIAN_DIR → /app/debian，DOCS_DIR → /app/docs
#   - NPM_CACHE_DIR → /app/data/cache/npm，DOCKER_CACHE_DIR → /app/data/cache/docker，
#     DEBIAN_CACHE_DIR → /app/data/cache/debian
#   - MAX_CONTENT_LENGTH → 104857600，与 nginx 的 client_max_body_size 100m 配套
#   - runner 侧的 AGENT_SANDBOX_UID/GID → 10002/10000、AGENT_WORK_ROOT → /work
#
# 刻意不暴露的三个后端变量（都需要同时改 compose / nginx，不是加一行环境变量）：
#   - AUTH_ENABLED：拓扑永远开着认证。关闭它 = 边缘 nginx 后面的管理面匿名可写，
#     要关请改 docker-compose.yml 并自行承担后果。
#   - ROUTE_PREFIX：nginx.conf 里的 /api、/simple、/npm… 全是写死的 location，
#     改了前缀服务即不可达。
#   - FRONTEND_DIST_DIR：只在 Flask 自己托管 SPA 时有意义；这里 SPA 由 frontend
#     容器供应，代码路径永远走不到（backend/routes/spa.py 也是这么写的）。
#
# 还有一类不是"部署配置"而是**进程间消息**的变量，由我们的代码自己设置、
# 不需要也不应该出现在这里：OPENFISH_ROLE（compose 已设）、OPENFISH_GIT_TOKEN /
# OPENFISH_GIT_HOST、OPENFISH_MODEL_*、OPENFISH_TASK_KIND、
# GUARDDOG_TOP_PACKAGES_CACHE_LOCATION（见 backend/config/__init__.py 的说明）。
