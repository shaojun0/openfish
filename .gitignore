# ── Python / build artifacts ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Frontend ────────────────────────────────────────────────────────
# Dependencies are installed locally; the bundle is produced by `npm run build`
# (or by the frontend image build) and is not committed.
frontend/node_modules/
frontend/dist/
frontend/.smoke/
backend/static/dist/
*.tsbuildinfo

# ── Local end-to-end scratch space ──────────────────────────────────
.e2e/

# ── Secrets & local config ──────────────────────────────────────────
# Never commit real credentials. Commit only the *.example templates.
.env
.env.local
docker/.env
!docker/.env.example
!backend/.env.example
# Forgejo's env file holds SECRET_KEY / INTERNAL_TOKEN / JWT_SECRET and the
# platform admin token; only the template is tracked.
docker/forgejo/forgejo.env
!docker/forgejo/forgejo.env.example
# Forgejo's bare repositories, SQLite database and logs; agent work directories.
docker/forgejo/
!docker/forgejo/README.md
!docker/forgejo/forgejo.env.example
docker/agent-work/

# ── Private test-environment bundle ─────────────────────────────────
# Plaintext passwords, the deployment handbook, TLS cert and runtime data
# for the public cpypiserver test environment. Local only — never commit.
.private/

# ── Local runtime data ──────────────────────────────────────────────
# The trailing * also covers the sidecar files SQLite creates in WAL mode
# (`.db-wal`, `.db-shm`, `.db-journal`), which the engine turns on explicitly.
backend/data/*.db*
backend/data/*.sqlite*
backend/data/*.sqlite3*
# Upstream read-through caches (npm packuments/tarballs, docker manifests and
# blobs, apt metadata). Derived data, potentially hundreds of megabytes —
# never committed.
backend/data/cache/
# Runtime JSON state: the device-authorization code store (`DEVICE_CODES_FILE`,
# which holds live user codes and the API keys they mint) and the model-health
# probe results (`MODEL_HEALTH_FILE`). Both are written by the server, neither
# is a fixture.
backend/data/*.json
# Safety net: the runtime database belongs in backend/data/. A stray root-level
# data/ (stale env file, a command run from the wrong directory) must never be
# committed — it is a live SQLite file, not a fixture.
/data/

# ── Docker deployment: pluggable bind-mount sources ─────────────────
# Every Compose bind source is a path under docker/.  On a real deployment the
# artifact/state directories there are symlinks to a data disk (docker/npm ->
# /media/.../npm, …) and docker/data -> ../backend/data.  They are created per
# None of them is committed; the committed sample catalogs live in
# docker/examples/ and are copied in by that script on a fresh checkout.
docker/.pre-symlink-backup/
docker/share
docker/npm
docker/node-builds
docker/docker-images
docker/debian
docker/data
docker/config/model_routes.json
# Uploaded packages and interpreter mirrors (bind-mounted in the container).
packages/
python-build-standalone/

# ── TLS material (private CA / certs / keys) ────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
# TLS material lives outside the web root.  Only the one file named by
# TLS_CA_FILE is ever served (GET /certs/ca_chain.pem) — `static/` is not a
# drop point any more, so a key here cannot be reached over HTTP.
certs/

# ── Editors / OS ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
