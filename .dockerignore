# ── Python / build artifacts ────────────────────────────────────────
__pycache__
*.pyc
*.pyo
.venv
*.egg-info
build/
dist/

# ── Frontend ────────────────────────────────────────────────────────
# node_modules is reinstalled inside the frontend build stage; the bundle is
# produced there too, so neither belongs in the build context.
frontend/node_modules/
frontend/.smoke/
static/dist/

# ── Git / IDE ───────────────────────────────────────────────────────
.git
.gitignore
.idea/

# ── Config / env / secrets ──────────────────────────────────────────
# Keep credentials and TLS material out of the image; inject them at runtime.
.env
.env.*
!.env.example
data/
api_keys_data/
*.pem
*.key
*.crt
static/certs/

# Private test-environment bundle: plaintext passwords, TLS cert and runtime
# data. Its files are root-owned 0600, which also makes the build context
# scan fail outright, so it must never be part of the context.
.private/

# ── Docker infra (not needed inside the image) ──────────────────────
docker/
Dockerfile
.dockerignore
docker-compose.yml

# ── Tests ──────────────────────────────────────────────────────────
tests/

# ── Data / archives / docs ──────────────────────────────────────────
packages/
# Interpreter mirrors hold multi-gigabyte archives and are bind-mounted at
# runtime; never send them as build context.
node-builds/
python-build-standalone/
*.zip
*.tar.gz
*.md
uv.lock
