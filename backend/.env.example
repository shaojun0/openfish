# ── 本地开发环境变量模板 ────────────────────────────────────────────
# 用法:  在 backend/ 目录下  cp .env.example .env  然后填写真实值。
# .env 已被 .gitignore 忽略，绝不会进入仓库。
#
# 变量命名规则：嵌套字段用双下划线分隔，例如 SERVER__PORT、AUTH__BASIC_USERNAME。
# 带别名的字段（Basic Auth、OAuth2）可直接使用下面的短名字。
#
# 关于路径变量：下面所有 *_DIR / *_FILE 的默认值都由代码锚定到仓库的两个根，
# 与启动时的工作目录无关，因此**本地开发通常一个都不用设**（已注释掉）：
#   backend/data、backend/packages、backend/certs、backend/config/…  → 后端自身状态
#   tools/、npm/、node-builds/、docker-images/、debian/、docs/        → 项目根的制品库
# Docker Compose 会把它们全部覆盖为 /app/… 的绝对路径
# （见 docker/docker-compose.yml）。只有要把某个目录挪到别处时，才取消注释并填写。

# ── 服务器 ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9090
DEBUG=false
LOG_LEVEL=INFO
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SERVER_NAME=cpypiserver
# 对外可达的绝对基址（设备授权流程签发的 verification_uri 用它拼绝对地址，
# DSH 企业内网插件会把这个地址展示给用户点击）。留空则从请求的
# Host / X-Forwarded-* 推导——走本仓库自带的 nginx 反代时留空即可。
# 例：PUBLIC_BASE_URL=https://47.97.243.86:9443
# 注意：这里只影响返回给客户端的 URL，不改变监听地址。
# PUBLIC_BASE_URL=
# 自备私网 CA 链（可选）。设成你的 CA 文件路径后，内网客户端可在
# GET /certs/ca_chain.pem 匿名下载它来信任本镜像源；文件不存在时该路由 404。
# 该路径**不在 web 根目录下**，且只会供应这一个文件——同目录里的私钥不会被暴露。
# TLS_CA_FILE=certs/ca_chain.pem
# 管理员白名单。必须是 JSON 数组，例如 ADMIN_USERS=["admin","alice"]。
# 注意：留空（ADMIN_USERS=）会导致启动报错，不需要时请保持注释状态。
#
# 这是**一次性冷启动种子**：只有 users 表里一个超管都没有时才生效，之后改这个
# 变量不再有任何作用（避免配置变成"谁能改环境变量谁就是超管"的永久后门）。
# 日常任命管理员请用 CLI：  python cli.py create-admin <账号>
# ADMIN_USERS=["admin"]

# ── Basic Auth ──────────────────────────────────────────────────────
# 总开关。设为 false 时凭据变成**可选而非忽略**：不带凭据的请求保持匿名，
# 由内置 anonymous 角色授权——而该角色只持有 doc:read。所以「关掉认证」等于
# **只开放文档**，不是「完全开放」：镜像、目录页和 Web 控制台仍然一律 403，
# 主界面（app:read）对匿名访客关闭。
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_ASSERT=

# ── OAuth2（全部留空则自动禁用 OAuth2 相关代码路径）───────────────
OAUTH2_PRODUCT_ID=0
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=
OAUTH2_AUTHORIZE_URL=
OAUTH2_INTROSPECT_URL=
# 私有 CA 证书路径（PEM）。留空 = 用系统信任库。
# 没有"关闭校验"的开关：introspection 一旦不校验证书，中间人就能伪造任意身份登录。
OAUTH2_CA_BUNDLE=
OAUTH2_AUTH_PREFERENCE=
IS_4A=false

# ── 存储 ────────────────────────────────────────────────────────────
# PACKAGES_DIR=packages
# PYTHON_BUILDS_DIR=python-build-standalone
# Node.js 预编译镜像（nodejs.org/dist 布局：node-builds/vX.Y.Z/*.tar.xz）。
# 供 nvm / fnm / node-gyp 通过 NVM_NODEJS_ORG_MIRROR 指向本服务。
# NODE_BUILDS_DIR=node-builds
# API_KEYS_FILE=data/cpypiserver.db
# 是否允许覆盖同名包
STORAGE__OVERWRITE=false

# ── 内网制品中心（工具 / npm / Docker / Debian / 模型路由 / 文档）─────
# 工具目录：每个一级子目录是一个分类，文件即下载项。
# TOOLS_DIR=tools
# 本地 npm 目录（*.tgz 与 catalog.json）。本地 tarball 只"赢得"它自己的版本，
# 不会遮蔽上游的其它版本（见 NPM_PROXY_ENABLED）。
# NPM_DIR=npm
# 上游 npm registry：既是 `npm config set registry` 指向的地址，
# 也是本地没有该包时的回源地址（只读穿透代理）。
NPM_UPSTREAM=https://registry.npmmirror.com
# 是否提供 npm registry 协议（packument / tarball / /-/v1/search）。
# 置 false 时仍可为本地已缓存的包提供服务，但未知包返回 404。
# 置 true 时 packument 会把上游的完整版本列表与本地 tarball 合并：只同步了
# 部分版本的包（例如只有 accepts@1.3.8）也能满足 express 对 accepts@^2.0.0 的
# 依赖，否则 npm 会报 ETARGET。上游不可达时自动降级为只用本地文件。
NPM_PROXY_ENABLED=true
# 上游 registry 需要鉴权时填写 Bearer token（留空为匿名）。
NPM_UPSTREAM_TOKEN=
# 上游读取超时（秒）与磁盘缓存预算。
NPM_TIMEOUT=30
# NPM_CACHE_DIR=data/cache/npm
NPM_CACHE_MAX_MB=512
# Docker 离线制品目录（docker save 的 tar、compose/Dockerfile）；
# 注意与仓库的 docker/ 基础设施目录区分。
# DOCKER_DIR=docker-images
# 页面上展示的内网 registry（留空则不展示）
DOCKER_REGISTRY=
# Registry v2 回源地址：Docker Hub 用 https://registry-1.docker.io，
# 内网 registry 用 http://registry.intra:5000。留空则只服务本地缓存。
DOCKER_UPSTREAM=
DOCKER_UPSTREAM_USERNAME=
DOCKER_UPSTREAM_PASSWORD=
# 单段镜像名默认补的命名空间（Docker Hub 官方镜像为 library；
# 内网 registry 不需要时置空）。
DOCKER_DEFAULT_NAMESPACE=library
DOCKER_TIMEOUT=60
# DOCKER_CACHE_DIR=data/cache/docker
DOCKER_CACHE_MAX_MB=1024
# Debian 本地包目录（.deb 与 apt 配置片段）
# DEBIAN_DIR=debian
# 页面上展示的内网 apt 镜像（留空则不展示）
DEBIAN_MIRROR=
# apt 回源地址，例如 http://deb.debian.org/debian。
# 留空则只提供由本地 .deb 生成的扁平 /debian/Packages 索引。
DEBIAN_UPSTREAM=
DEBIAN_TIMEOUT=60
# DEBIAN_CACHE_DIR=data/cache/debian
DEBIAN_CACHE_MAX_MB=256
# 代理的 apt 元数据（Release / Packages）缓存有效期（秒）
DEBIAN_METADATA_TTL=300
# 模型路由表（JSON），供下游 DSH 读取；持有 model:write 的管理员可在 /models
# 页面在线增删改，因此该文件所在目录必须对服务进程可写。
#
# ⚠ 这个文件**会被提交进仓库**，所以里面不能放密钥。一条路由的密钥有两种给法：
#   1) `api_key_env: SOME_VAR` —— 文件里只留**变量名**，值由部署时注入进程环境。
#      这是让路由表可提交、可共享的正确姿势（下面的 ENTERPRISE_DEEPSEEK_API_KEY
#      就是这类变量；真实值放 .env / .private/ 里，别写进这个 JSON）。
#   2) `api_key: "sk-..."` —— 直接写值。/models 页面在线编辑走的就是这条路，
#      但那之后这个文件就带密了，**不要再提交**。
# 两者同时存在时 api_key 优先；变量名解析不到会以 api_key_source=env-missing
# 暴露在 /api/v1/models，而不会假装已配置。
# MODELS_FILE=config/model_routes.json
# 路由表里 api_key_env 指向的上游密钥（示例名）。按你的路由表实际用到的名字填。
# 留空 = 该路由未配置密钥（探活会报 auth，下游 DSH 会拿到空 key）。
ENTERPRISE_DEEPSEEK_API_KEY=
# 连通性检测结果存放位置（按路由名记录，不写入上面的路由表，保持发布文档纯净）
# MODEL_HEALTH_FILE=data/model_health.json
# 单条路由连通性检测的超时（秒）
MODEL_PROBE_TIMEOUT=5
# 设备授权流程（DSH 企业内网插件用它在用户登录后自动领取 API key）的挂起请求
# 存放位置。device_code 只以 SHA-256 落盘，明文密钥不写文件；单进程容器用进程内
# 锁串行化读写。该文件需对服务进程可写，且**不要备份**。
# DEVICE_CODES_FILE=data/device_codes.json
# 一个挂起请求的有效期（秒）；超时后插件必须重新发起。
DEVICE_CODE_TTL=900
# 各生态 Markdown 文档目录：每个一级子目录对应一个生态
# （python / npm / docker / debian / tools / models），生态目录下每篇文档是一个
# 文件夹项目（<文档标识>/document.md，另有 meta.json 标题与 assets/ 附件目录）。
# 只有管理员（doc:upload）可以在浏览器中在线编辑、新增/删除文档并上传附件，
# 其他用户仅可查看和下载（doc:read）。
# DOCS_DIR=docs

# ── 安全（ClamAV 病毒扫描，留空则禁用）─────────────────────────────
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_REQUIRED=false
