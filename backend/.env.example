# ── 本地开发环境变量模板 ────────────────────────────────────────────
# 用法:  在 backend/ 目录下  cp .env.example .env  然后填写真实值。
# .env 已被 .gitignore 忽略，绝不会进入仓库。
#
# 变量命名规则：每个变量都在 backend/config/ 里声明（一个域一个模块，字段上的
# description 就是它的文档），这里列出的是同一批名字。两种写法等价：
#   * 扁平名 —— 字段名大写，或该域的前缀加上字段名，例如 PORT、AGENT_WORK_ROOT、
#     FORGEJO_BASE_URL。部署（docker-compose.yml）用的就是这一种。
#   * 嵌套名 —— 域__字段，例如 SERVER__PORT、AUTH__BASIC_USERNAME。
# 带别名的字段（Basic Auth、OAuth2）可直接使用下面的短名字。
#
# **留空等同于未设置**：`FOO=` 与不写 FOO 完全一样，取声明里的默认值。compose 的
# `${FOO:-}` 在运维没填时注入的就是空串，以前那会让 int/bool/JSON 字段启动报错，
# 现在按默认值处理。
#
# 变量只在进程启动时读一次，运行期不再重读；能读到进程环境的人不能中途改配置。
# 规则由 scripts/check_env_ownership.py 把守：deployment 设的每个变量都必须有对应
# 字段，业务代码里也不允许再出现手写的 os.environ。
#
# 关于路径变量：下面所有 *_DIR / *_FILE 的默认值都由代码锚定到仓库的两个根，
# 与启动时的工作目录无关，因此**本地开发通常一个都不用设**（已注释掉）：
#   backend/data、backend/packages、backend/certs、backend/config/…  → 后端自身状态
#   tools/、npm/、node-builds/、docker-images/、debian/、docs/        → 项目根的制品库
# Docker Compose 会把它们全部覆盖为 /app/… 的绝对路径
# （见 docker/docker-compose.yml）。只有要把某个目录挪到别处时，才取消注释并填写。

# ── 服务器 ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9090
DEBUG=false
LOG_LEVEL=INFO
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SERVER_NAME=cpypiserver
# 对外可达的绝对基址（设备授权流程签发的 verification_uri 用它拼绝对地址，
# DSH 企业内网插件会把这个地址展示给用户点击）。留空则从请求的
# Host / X-Forwarded-* 推导——走本仓库自带的 nginx 反代时留空即可。
# 例：PUBLIC_BASE_URL=https://47.97.243.86:9443
# 注意：这里只影响返回给客户端的 URL，不改变监听地址。
# PUBLIC_BASE_URL=
# 自备私网 CA 链（可选）。设成你的 CA 文件路径后，内网客户端可在
# GET /certs/ca_chain.pem 匿名下载它来信任本镜像源；文件不存在时该路由 404。
# 该路径**不在 web 根目录下**，且只会供应这一个文件——同目录里的私钥不会被暴露。
# TLS_CA_FILE=certs/ca_chain.pem
# 管理员白名单。必须是 JSON 数组，例如 ADMIN_USERS=["admin","alice"]。
# 留空（ADMIN_USERS=）等同于未设置，即没有冷启动超管。
#
# 这是**一次性冷启动种子**：只有 users 表里一个超管都没有时才生效，之后改这个
# 变量不再有任何作用（避免配置变成"谁能改环境变量谁就是超管"的永久后门）。
# 日常任命管理员请用 CLI：  python cli.py create-admin <账号>
# ADMIN_USERS=["admin"]

# ── Basic Auth ──────────────────────────────────────────────────────
# 总开关。设为 false 时凭据变成**可选而非忽略**：不带凭据的请求保持匿名，
# 由内置 anonymous 角色授权——而该角色只持有 doc:read。所以「关掉认证」等于
# **只开放文档**，不是「完全开放」：镜像、目录页和 Web 控制台仍然一律 403，
# 主界面（app:read）对匿名访客关闭。
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_ASSERT=

# ── OAuth2（全部留空则自动禁用 OAuth2 相关代码路径）───────────────
OAUTH2_PRODUCT_ID=0
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=
OAUTH2_AUTHORIZE_URL=
OAUTH2_INTROSPECT_URL=
# 私有 CA 证书路径（PEM）。留空 = 用系统信任库。
# 没有"关闭校验"的开关：introspection 一旦不校验证书，中间人就能伪造任意身份登录。
OAUTH2_CA_BUNDLE=
OAUTH2_AUTH_PREFERENCE=
IS_4A=false

# ── 存储 ────────────────────────────────────────────────────────────
# PACKAGES_DIR=packages
# PYTHON_BUILDS_DIR=python-build-standalone
# Node.js 预编译镜像（nodejs.org/dist 布局：node-builds/vX.Y.Z/*.tar.xz）。
# 供 nvm / fnm / node-gyp 通过 NVM_NODEJS_ORG_MIRROR 指向本服务。
# NODE_BUILDS_DIR=node-builds
# API_KEYS_FILE=data/cpypiserver.db
# 数据库后端。留空 = 使用上面的 SQLite 文件（默认，单机零依赖）。
# 设为 PostgreSQL URL 即把 API key / 用户 / 角色 / 权限 / 统计整体切过去，
# 五个 RBAC 表与 api_keys、api_key_stats 都在同一个库里；没有"一半 SQLite
# 一半 PostgreSQL"的模式（跨库删除无法回滚）。
# 需要先安装驱动：pip install 'psycopg[binary]'（镜像里已随 pyproject 装好）。
# 口令含 @ : / 等字符时做 URL 编码。口令只从环境读，不要写进模板或提交：
# DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/openfish
# 是否允许覆盖同名包
STORAGE__OVERWRITE=false

# ── 内网制品中心（工具 / npm / Docker / Debian / 模型路由 / 文档）─────
# 工具目录：每个一级子目录是一个分类，文件即下载项。
# TOOLS_DIR=tools
# 本地 npm 目录（*.tgz 与 catalog.json）。本地 tarball 只"赢得"它自己的版本，
# 不会遮蔽上游的其它版本（见 NPM_PROXY_ENABLED）。
# NPM_DIR=npm
# 上游 npm registry：既是 `npm config set registry` 指向的地址，
# 也是本地没有该包时的回源地址（只读穿透代理）。
NPM_UPSTREAM=https://registry.npmmirror.com
# 是否提供 npm registry 协议（packument / tarball / /-/v1/search）。
# 置 false 时仍可为本地已缓存的包提供服务，但未知包返回 404。
# 置 true 时 packument 会把上游的完整版本列表与本地 tarball 合并：只同步了
# 部分版本的包（例如只有 accepts@1.3.8）也能满足 express 对 accepts@^2.0.0 的
# 依赖，否则 npm 会报 ETARGET。上游不可达时自动降级为只用本地文件。
NPM_PROXY_ENABLED=true
# 上游 registry 需要鉴权时填写 Bearer token（留空为匿名）。
NPM_UPSTREAM_TOKEN=
# 上游读取超时（秒）与磁盘缓存预算。
NPM_TIMEOUT=30
# NPM_CACHE_DIR=data/cache/npm
NPM_CACHE_MAX_MB=512
# Docker 离线制品目录（docker save 的 tar、compose/Dockerfile）；
# 注意与仓库的 docker/ 基础设施目录区分。
# DOCKER_DIR=docker-images
# 页面上展示的内网 registry（留空则不展示）
DOCKER_REGISTRY=
# Registry v2 回源地址：Docker Hub 用 https://registry-1.docker.io，
# 内网 registry 用 http://registry.intra:5000。留空则只服务本地缓存。
DOCKER_UPSTREAM=
DOCKER_UPSTREAM_USERNAME=
DOCKER_UPSTREAM_PASSWORD=
# 单段镜像名默认补的命名空间（Docker Hub 官方镜像为 library；
# 内网 registry 不需要时置空）。
DOCKER_DEFAULT_NAMESPACE=library
DOCKER_TIMEOUT=60
# DOCKER_CACHE_DIR=data/cache/docker
DOCKER_CACHE_MAX_MB=1024
# Debian 本地包目录（.deb 与 apt 配置片段）
# DEBIAN_DIR=debian
# 页面上展示的内网 apt 镜像（留空则不展示）
DEBIAN_MIRROR=
# apt 回源地址，例如 http://deb.debian.org/debian。
# 留空则只提供由本地 .deb 生成的扁平 /debian/Packages 索引。
DEBIAN_UPSTREAM=
DEBIAN_TIMEOUT=60
# DEBIAN_CACHE_DIR=data/cache/debian
DEBIAN_CACHE_MAX_MB=256
# 代理的 apt 元数据（Release / Packages）缓存有效期（秒）
DEBIAN_METADATA_TTL=300
# 模型路由表（数据库表 model_routes，与队列同一个库），供下游 DSH 读取；持有
# model:write 的管理员可在 /models 页面在线增删改。不再有 MODELS_FILE：路由随
# API_KEYS_FILE / DATABASE_URL 指向的数据库一起持久化，全新部署可用
# config/model_routes.seed.sql 预置一组路由（见 docker/README.md）。
#
# 每条路由按两个正交维度分类：
#   provider —— 调用协议：openai / mineru / anthropic（决定请求形状与默认 path）
#   kind     —— 模型功能：chat / completion / embedding / rerank / ocr / asr / tts
# kind 留空按协议取默认值（openai、anthropic → chat，mineru → ocr），旧行无需
# 一次性补齐。下游 DSH 只把 chat / completion 注册成对话模型，embedding / ocr 等
# 只在 /models 页面登记，供向量库、文档解析等其它消费者使用。
#
# ⚠ 一条路由的密钥**只有一种给法**：`api_key: "sk-..."`。值在落库前用 Fernet
# 密封（信封前缀 enc:v1:），所以数据库、备份和副本里都不含可直接使用的凭证；
# 明文只存在于即将发请求的那个进程里。
#
# 因此上游密钥**不是**配置项，而是数据 —— 由 `MODEL_ROUTE_KEY`（下面）加密后
# 写进表里。两种写法：
#   * /models 页面在线编辑（需要 model:write）；
#   * CLI：python cli.py model-route set-key deepseek-flash \
#            --key-env ENTERPRISE_DEEPSEEK_API_KEY
#     `--key-env` 从进程环境读值（密钥不进 argv / shell history），只把密封结果
#     落库。省略该参数则改用隐藏提示输入。
# 不再有 `api_key_env` 列：它让一行的可用性取决于部署进程的环境，而
# /api/v1/models/resolved 无论如何都会把明文交给下游客户端，保密收益是假的。
# 旧库里 api_key_env 的值会在启动时随列一起被丢弃（那里只有变量名，没有秘密），
# 需要重新用上面的命令设置真实密钥；旧行里**明文**的 api_key 仍可读，并会以
# api_key_source=plaintext 暴露在 /api/v1/models，用 `cli.py model-route seal`
# 一次性重新密封。
#
# 路由密钥主密钥。留空 = 拒绝写入任何路由密钥（fail-closed，绝不降级明文），
# 已密封的行会报 api_key_source=unreadable。生成方式同 SECRET_KEY。
# 换密钥会导致旧信封无法解开，轮换需先解密再重新 set-key。
# MODEL_ROUTE_KEY=
# 上游密钥的**值**放在这里只是为了给上面的 set-key 命令读（放在 .env 或
# .private/ 里），应用本身不读它 —— 它不是配置项，只是 set-key 那一瞬间的输入。
# 可以按你的路由表实际用到的名字增减：
# ENTERPRISE_DEEPSEEK_API_KEY=
# 连通性检测结果存在该路由自己那一行上（弹窗展示用），单条路由检测的超时（秒）
MODEL_PROBE_TIMEOUT=5
# 探活白名单（JSON 数组，元素是 host 或 host:port，精确匹配）。留空 = 允许任意
# http(s) 主机，但一律拒绝云元数据 / 链路本地地址（169.254.0.0/16、100.64.0.0/10、
# fe80::/10 等，见 services/urlsafety.py）。设为 JSON 数组后只能探活名单内的主机。
# MODEL_PROBE_ALLOWED_HOSTS=["vllm.intra:8000","api.deepseek.com"]
# 设备授权流程（DSH 企业内网插件用它在用户登录后自动领取 API key）的挂起请求
# 存放位置。device_code 只以 SHA-256 落盘，明文密钥不写文件；单进程容器用进程内
# 锁串行化读写。该文件需对服务进程可写，且**不要备份**。
# DEVICE_CODES_FILE=data/device_codes.json
# 一个挂起请求的有效期（秒）；超时后插件必须重新发起。
DEVICE_CODE_TTL=900
# 各生态 Markdown 文档目录：每个一级子目录对应一个生态
# （python / npm / docker / debian / tools / models），生态目录下每篇文档是一个
# 文件夹项目（<文档标识>/document.md，另有 meta.json 标题与 assets/ 附件目录）。
# 只有管理员（doc:upload）可以在浏览器中在线编辑、新增/删除文档并上传附件，
# 其他用户仅可查看和下载（doc:read）。
# DOCS_DIR=docs

# ── 安全（上传校验：ClamAV + GuardDog）─────────────────────────────
# ClamAV 病毒扫描。HOST 留空即禁用（与 GuardDog 的“缺失不报错”不同，这里是显式开关）。
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
# ClamAV 不可用时是否拒绝上传（false = 告警后放行）。
CLAMAV_REQUIRED=false
# GuardDog 恶意包静态分析（YARA 规则 + 风险评分）随依赖安装，Linux/macOS 上自动生效；
# 它的 nono-py 依赖没有 Windows wheel，所以 Windows 开发机上会打印告警并跳过扫描。
# 生产镜像（Debian）始终具备，无需额外开关。
GUARDDOG_ENABLED=true
# 风险分达到该值即拒绝上传（0-10）。5.0 是 GuardDog 自己的 "suspicious" 档位：
# 再往下是“只是打开了 socket / 读了文件”的能力匹配，正常库几乎都会命中。
GUARDDOG_MIN_RISK_SCORE=5.0
# GuardDog 不可用时是否拒绝上传（false = 告警后放行，与 CLAMAV_REQUIRED 语义一致）。
GUARDDOG_REQUIRED=false
# GuardDog "top packages" 列表的缓存目录。服务启动时会把它自带的列表固化到这里并
# 打上远期时间戳，否则 GuardDog 会在 import 时去 github.com 拉取（无超时），
# 内网/离线环境既拉不到也会卡住首次上传。该目录必须可写。
# GUARDDOG_CACHE_DIR=data/guarddog
