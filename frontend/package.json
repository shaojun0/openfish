{
  "name": "cpypiserver-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cpypiserver admin console — Vue 3 + Vite + Element Plus",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "smoke": "node ./node_modules/vite/bin/vite.js build --ssr scripts/smoke-render.ts --outDir .smoke --emptyOutDir && node .smoke/smoke-render.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^30.0.1",
    "sass": "^1.104.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
