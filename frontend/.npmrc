# This repository may be checked out on a filesystem without symlink support
# (NTFS / exFAT USB drives), where npm's default node_modules/.bin symlinks
# cannot be created.  Disable bin links and invoke the toolchain directly:
#   node ./node_modules/vite/bin/vite.js build
# See the "scripts" block in package.json.
bin-links=false
fund=false
audit=false
