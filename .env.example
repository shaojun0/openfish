# ── 本地开发环境变量模板 ────────────────────────────────────────────
# 用法:  cp .env.example .env  然后填写真实值。
# .env 已被 .gitignore 忽略，绝不会进入仓库。
#
# 变量命名规则：嵌套字段用双下划线分隔，例如 SERVER__PORT、AUTH__BASIC_USERNAME。
# 带别名的字段（Basic Auth、OAuth2）可直接使用下面的短名字。

# ── 服务器 ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9090
DEBUG=false
LOG_LEVEL=INFO
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SERVER_NAME=cpypiserver
# 管理员白名单。必须是 JSON 数组，例如 ADMIN_USERS=["admin","alice"]。
# 注意：留空（ADMIN_USERS=）会导致启动报错，不需要时请保持注释状态。
#
# 这是**一次性冷启动种子**：只有 users 表里一个超管都没有时才生效，之后改这个
# 变量不再有任何作用（避免配置变成"谁能改环境变量谁就是超管"的永久后门）。
# 日常任命管理员请用 CLI：  python cli.py create-admin <账号>
# ADMIN_USERS=["admin"]

# ── Basic Auth ──────────────────────────────────────────────────────
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_ASSERT=

# ── OAuth2（全部留空则自动禁用 OAuth2 相关代码路径）───────────────
OAUTH2_PRODUCT_ID=0
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=
OAUTH2_AUTHORIZE_URL=
OAUTH2_INTROSPECT_URL=
# 私有 CA 证书路径（PEM）。留空 = 用系统信任库。
# 没有"关闭校验"的开关：introspection 一旦不校验证书，中间人就能伪造任意身份登录。
OAUTH2_CA_BUNDLE=
OAUTH2_ISSUER=
OAUTH2_AUTH_PREFERENCE=
IS_4A=false

# ── 存储 ────────────────────────────────────────────────────────────
PACKAGES_DIR=packages
PYTHON_BUILDS_DIR=python-build-standalone
# Node.js 预编译镜像（nodejs.org/dist 布局：node-builds/vX.Y.Z/*.tar.xz）。
# 供 nvm / fnm / node-gyp 通过 NVM_NODEJS_ORG_MIRROR 指向本服务。
NODE_BUILDS_DIR=node-builds
API_KEYS_FILE=data/cpypiserver.db
# 是否允许覆盖同名包
STORAGE__OVERWRITE=false

# ── 内网制品中心（工具 / npm / Docker / Debian / 模型路由 / 文档）─────
# 工具目录：每个一级子目录是一个分类，文件即下载项。
TOOLS_DIR=tools
# 本地 npm 目录（*.tgz 与 catalog.json）。本地 tarball 只"赢得"它自己的版本，
# 不会遮蔽上游的其它版本（见 NPM_PROXY_ENABLED）。
NPM_DIR=npm
# 上游 npm registry：既是 `npm config set registry` 指向的地址，
# 也是本地没有该包时的回源地址（只读穿透代理）。
NPM_UPSTREAM=https://registry.npmmirror.com
# 是否提供 npm registry 协议（packument / tarball / /-/v1/search）。
# 置 false 时仍可为本地已缓存的包提供服务，但未知包返回 404。
# 置 true 时 packument 会把上游的完整版本列表与本地 tarball 合并：只同步了
# 部分版本的包（例如只有 accepts@1.3.8）也能满足 express 对 accepts@^2.0.0 的
# 依赖，否则 npm 会报 ETARGET。上游不可达时自动降级为只用本地文件。
NPM_PROXY_ENABLED=true
# 上游 registry 需要鉴权时填写 Bearer token（留空为匿名）。
NPM_UPSTREAM_TOKEN=
# 上游读取超时（秒）与磁盘缓存预算。
NPM_TIMEOUT=30
NPM_CACHE_DIR=data/cache/npm
NPM_CACHE_MAX_MB=512
# Docker 离线制品目录（docker save 的 tar、compose/Dockerfile）；
# 注意与仓库的 docker/ 基础设施目录区分。
DOCKER_DIR=docker-images
# 页面上展示的内网 registry（留空则不展示）
DOCKER_REGISTRY=
# Registry v2 回源地址：Docker Hub 用 https://registry-1.docker.io，
# 内网 registry 用 http://registry.intra:5000。留空则只服务本地缓存。
DOCKER_UPSTREAM=
DOCKER_UPSTREAM_USERNAME=
DOCKER_UPSTREAM_PASSWORD=
# 单段镜像名默认补的命名空间（Docker Hub 官方镜像为 library；
# 内网 registry 不需要时置空）。
DOCKER_DEFAULT_NAMESPACE=library
DOCKER_TIMEOUT=60
DOCKER_CACHE_DIR=data/cache/docker
DOCKER_CACHE_MAX_MB=1024
# Debian 本地包目录（.deb 与 apt 配置片段）
DEBIAN_DIR=debian
# 页面上展示的内网 apt 镜像（留空则不展示）
DEBIAN_MIRROR=
# apt 回源地址，例如 http://deb.debian.org/debian。
# 留空则只提供由本地 .deb 生成的扁平 /debian/Packages 索引。
DEBIAN_UPSTREAM=
DEBIAN_TIMEOUT=60
DEBIAN_CACHE_DIR=data/cache/debian
DEBIAN_CACHE_MAX_MB=256
# 代理的 apt 元数据（Release / Packages）缓存有效期（秒）
DEBIAN_METADATA_TTL=300
# 模型路由表（JSON），供下游 DSH 读取
MODELS_FILE=config/model_routes.json
# 各生态 Markdown 文档目录：每个一级子目录对应一个生态
# （python / npm / docker / debian / tools / models），存放该生态的 *.md 文档。
# 无论放在哪一层，文档都以 Markdown 形式发布；只有管理员（doc:upload）
# 可以上传 .md 文件新增或覆盖内容，其他用户仅可查看和下载（doc:read）。
DOCS_DIR=docs

# ── 安全（ClamAV 病毒扫描，留空则禁用）─────────────────────────────
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_REQUIRED=false
